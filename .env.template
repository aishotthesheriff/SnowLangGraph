# Snowflake Connection Settings
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
# Password, or a programmatic access token (PAT). A PAT needs a network policy on the user.
SNOWFLAKE_PASSWORD=your_password
# Optional: set this for SSO, e.g. externalbrowser, or PROGRAMMATIC_ACCESS_TOKEN.
# With PROGRAMMATIC_ACCESS_TOKEN the token comes from SNOWFLAKE_TOKEN, or else SNOWFLAKE_PASSWORD.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_TOKEN=your_pat
# sql/02 and sql/05 hardcode SNOWFLAKE_LEARNING_WH, so use the same name or edit those files.
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_ROLE=your_role

# Database for customer data and analytics
SNOWFLAKE_DATABASE=CUSTOMER_INTELLIGENCE_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Database/Schema for Cortex Agents (used by studio_app.py)
SNOWFLAKE_AGENT_DATABASE=SNOWFLAKE_INTELLIGENCE
SNOWFLAKE_AGENT_SCHEMA=AGENTS

# false (default) = trial-compatible mode: Cortex Analyst REST API + SQL.
# true = call the managed Cortex Agents from sql/05. Needs a paid Snowflake account.
SNOWFLAKE_USE_CORTEX_AGENTS=false

# Optional: LangSmith for tracing (get key from smith.langchain.com)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
